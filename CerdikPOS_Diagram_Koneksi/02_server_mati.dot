digraph G {
rankdir=LR;
graph [bgcolor="white", pad="0.26", nodesep="0.38", ranksep="0.55", fontname="Lato", fontsize=20, fontcolor="#172B42", labelloc=t, labeljust=l, splines=polyline, dpi=180];
node [shape=box, style="rounded,filled", color="#9BAFC2", fillcolor="#F2F6FA", fontcolor="#172B42", fontname="Lato", fontsize=12, penwidth=1.4, margin="0.18,0.12"];
edge [color="#147D77", fontcolor="#285E61", fontname="Lato", fontsize=10, penwidth=1.8, arrowsize=0.8];

label="02  |  PC server lokal mati";

subgraph cluster_k {label="Perangkat Kasir • PWA sudah siap offline"; style="rounded,filled";color="#CBD9E4";fillcolor="#F8FAFC";fontname="Lato";fontsize=12;fontcolor="#51677B";labeljust=l;
 k [label="Kasir\nTransaksi offline",fillcolor="#E7F5F2",color="#499B90"];
 idb [label="IndexedDB\nAntrean transaksi",shape=cylinder,fillcolor="#E7F5F2",color="#499B90"];
 k -> idb [label="Simpan lokal"];
}
subgraph cluster_s {label="Server lokal"; style="rounded,filled";color="#CBD9E4";fillcolor="#F8FAFC";fontname="Lato";fontsize=12;fontcolor="#51677B";labeljust=l;
 s [label="PC server\nTidak tersedia",fillcolor="#FFF0EF",color="#C95C56",fontcolor="#8B3936"];
 db [label="PostgreSQL",shape=cylinder,fillcolor="#FFF0EF",color="#C95C56",fontcolor="#8B3936"];
 s -> db [label="Setelah pulih",style=dashed,color="#9A681D",fontcolor="#805711"];
}
idb -> s [label="Sync saat server pulih",style=dashed,color="#9A681D",fontcolor="#805711"];
d [label="Direktur\nPerangkat pribadi"];
d -> s [label="NetBird: akses gagal",style=dashed,color="#C95C56",fontcolor="#9C413B",arrowhead=tee];

}
