digraph G {
rankdir=LR;
graph [bgcolor="white", pad="0.26", nodesep="0.38", ranksep="0.55", fontname="Lato", fontsize=20, fontcolor="#172B42", labelloc=t, labeljust=l, splines=polyline, dpi=180];
node [shape=box, style="rounded,filled", color="#9BAFC2", fillcolor="#F2F6FA", fontcolor="#172B42", fontname="Lato", fontsize=12, penwidth=1.4, margin="0.18,0.12"];
edge [color="#147D77", fontcolor="#285E61", fontname="Lato", fontsize=10, penwidth=1.8, arrowsize=0.8];

label="04  |  Direktur multi-device";

subgraph cluster_d {label="Satu akun Direktur • sesi independen"; style="rounded,filled";color="#CBD9E4";fillcolor="#F8FAFC";fontname="Lato";fontsize=12;fontcolor="#51677B";labeljust=l;
 h [label="HP\nSesi logout",fillcolor="#FFF0EF",color="#C95C56",fontcolor="#8B3936"];
 l [label="Laptop\nSesi aktif",fillcolor="#E7F5F2",color="#499B90"];
 p [label="PC\nSesi aktif",fillcolor="#E7F5F2",color="#499B90"];
 t [label="Tablet\nSesi aktif",fillcolor="#E7F5F2",color="#499B90"];
 {rank=same;h;l;p;t;}
}
